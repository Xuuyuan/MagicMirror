{
  "name": "magic-mirror",
  "version": "1.0.0-beta.12",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@noble/ciphers": "^2.4.0",
    "@tanstack/react-query": "^5.90.5",
    "expo": "~57.0.25",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-intent-launcher": "~57.0.1",
    "expo-linking": "~57.0.11",
    "expo-media-library": "~57.0.5",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-markdown-display": "^7.0.2",
    "react-native-paper": "^5.15.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@material/material-color-utilities": "^0.2.7",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.13",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~57.0.2",
    "expo-doctor": "^1.20.4",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "android:mumu": "powershell -ExecutionPolicy Bypass -File tools/start-mumu-debug.ps1 -DevelopmentBuild",
    "build:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-apk.ps1 -DebugBuild",
    "build:debug:mumu": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-apk.ps1 -DebugBuild -Architectures x86_64",
    "build:release": "npm run check && powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-apk.ps1",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:release",
    "format": "prettier --write \"{app,src,__mocks__,plugins,tools}/**/*.{js,cjs,mjs,ts,tsx}\" \"*.{js,ts,json}\"",
    "format:check": "prettier --check \"{app,src,__mocks__,plugins,tools}/**/*.{js,cjs,mjs,ts,tsx}\" \"*.{js,ts,json}\"",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:release": "node --test tools/__tests__/*.test.cjs",
    "doctor": "expo-doctor"
  },
  "private": true
}
